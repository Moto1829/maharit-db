CREATE (t:City {name:"Tokyo"})-[:ROAD]->(s:City {name:"Sendai"})-[:FERRY]->(p:City {name:"Sapporo"}), (t)-[:AIR]->(p)
MATCH p = (a:City {name: "Tokyo"})-[:ROAD|FERRY*1..5]->(b:City {name: "Sapporo"}) RETURN [n IN nodes(p) | n.name] AS route, length(p) AS hops ORDER BY hops
EXPLAIN MATCH (a)-[:ROAD|FERRY]->(b) RETURN b
